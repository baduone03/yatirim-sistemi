# Bu dosyayi .env olarak kopyala ve degerleri ASAGIDAKI satirlara yaz.
#
# DIKKAT: '#' ile baslayan her satir yorumdur, okunmaz.
# Degeri yorum satirina yazarsan sistem goremez.
# Dogru:  TELEGRAM_CHAT_ID=123456789
# Yanlis: # TELEGRAM_CHAT_ID : 123456789
#
# Token nereden alinir : Telegram'da @BotFather -> /newbot
# Chat ID nereden alinir: Telegram'da @userinfobot
#
# Bot sana mesaj atabilmesi icin once bota Telegram'dan Start demen gerekir,
# aksi halde "chat not found" hatasi alinir.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TCMB EVDS API anahtari.
# SU AN KULLANILMIYOR - USD/TRY, anahtar istemeyen bir uc noktadan aliniyor
# (varliklar.yaml -> veri_kaynaklari.tcmb.url). Sirri gerekmeyen yere
# gondermemek icin bilincli olarak devre disi. Anahtar isteyen bir EVDS
# serisine ihtiyac dogarsa buraya yazilir.
# Anahtar nereden alinir: evds3.tcmb.gov.tr -> uyelik -> Profil -> API Anahtari
EVDS_API_ANAHTARI=
