# BEYAZ LISTE MANTIGI
#
# Once her sey yok sayilir, sonra yalnizca acikca izin verilenler eklenir.
# Sebep: bu bir kisisel bilgi tabani. Kara liste kullanilsaydi yeni acilan
# her not klasoru yanlislikla GitHub'a gidebilirdi. Beyaz listede yeni
# klasorler varsayilan olarak DISARIDA kalir.
#
# GitHub'a giden: yatirim sistemi kodu + yapilandirmasi + raporlari.
# GitHub'a GITMEYEN: 01-inbox, 02-sources, 03-wiki, 05-daily, 06-archive,
#                    memory.md, .obsidian, .env

/*

!/.gitignore
!/.env.example
!/.github/
!/CLAUDE.md
!/README.md
!/scripts/

# Telegram webhook'unu karsilayan Cloudflare Worker. Yalnizca KOD ve
# kurulum notu; hicbir anahtar burada durmaz - token'lar `wrangler secret
# put` ile Cloudflare'e girilir ve dosyaya hic yazilmaz.
!/altyapi/

# Terfi kapisini gecmis, dogrulanmis notlar. 03-wiki calisma alanidir ve
# GitHub'a CIKMAZ; buraya yalnizca 7 kontrolu gecen not kopyalanir.
!/07-dogrulanmis/

# 06-archive icinden yalnizca gotcha gecmisi izlenir. Arsivin geri kalani
# kisisel not, disarida kalir; bu dosya CLAUDE.md'den cikarilan kurallarin
# tek kaydi oldugu icin yedeklenmesi gerekiyor.
!/06-archive/
/06-archive/*
!/06-archive/gotcha-gecmisi.md

# Slash komutlari kod sayilir. settings.local.json disarida kalir - makineye
# ozgu izinler tasir.
!/.claude/
/.claude/*
!/.claude/commands/

# 04-projects icinden yalnizca yatirim-sistemi izlenir
!/04-projects/
/04-projects/*
!/04-projects/yatirim-sistemi/

# --- izin verilen dizinlerin icinden cikarilanlar ---

# Gercek credential - asla commit edilmez
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Yerel calisma loglari (Actions'ta uretilmez) - her yerdeki loglar/ dizini
loglar/

# Wrangler build artifakti - Cloudflare deploy'unda yeniden uretilir
.wrangler/

# Gunluk haber dokumu: turetilmis veri, her /haber komutunda yeniden
# uretilir ve gunde bir dosya birikir. Rapor gibi degil - rapor portfoy
# durumunun kaydi, bu yalnizca o anki basliklarin kopyasi.
/04-projects/yatirim-sistemi/haberler/
